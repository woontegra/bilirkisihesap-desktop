{
  "name": "bilirkisi-desktop",
  "version": "3.6.5",
  "private": true,
  "description": "Bilirkişi Hesap bağımsız Windows/macOS masaüstü uygulaması",
  "author": "Woontegra",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "config": {
    "updateBaseUrl": "https://updates.woontegra.com/updates/bilirkisi-hesap-desktop/windows"
  },
  "scripts": {
    "dev": "vite",
    "dev:license": "node scripts/dev-license.mjs",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "oxlint src",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:win:update": "node scripts/run-dist-win-update.cjs",
    "release:update": "node scripts/run-release-update.cjs",
    "release:update:current": "node scripts/run-release-update-current.cjs",
    "release:update:metadata": "node scripts/run-release-update-metadata.cjs",
    "test:updater": "node scripts/run-updater-selftest.cjs",
    "test:parity": "npx vite-node --config vite.config.ts src/pages/hesaplamalar/shared/bruttenNeteParity.selftest.ts",
    "dist:mac": "npm run build && electron-builder --mac dmg zip"
  },
  "build": {
    "appId": "com.woontegra.bilirkisihesap",
    "productName": "Bilirkişi Hesap",
    "artifactName": "Bilirkisi-Hesap-Setup-${version}.${ext}",
    "afterPack": "scripts/mac-ascii-bundle-names.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bilirkişi Hesap",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Bilirkisi-Hesap-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "publish": [
        {
          "provider": "generic",
          "url": "https://updates.woontegra.com/updates/bilirkisi-hesap-desktop/macos"
        }
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.woontegra.com/updates/bilirkisi-hesap-desktop/windows"
      }
    ]
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "better-sqlite3": "^11.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.26.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "36.3.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.4"
  }
}
