# Merkezi lisans (Woontegra Lisans Server public API)
# Boş bırakılırsa Müvekkil Kasa ile aynı varsayılan Railway adresi kullanılır.
# LICENSE_API_BASE=
# LICENSE_API_BASE=https://lisans-server-backend-production.up.railway.app/api/public/license
#
# Yalnızca unpackaged development. Production paketinde yok sayılır / unconfigured.
# LICENSE_USE_MOCK=1
#
# Geliştirme: TCMB EVDS anahtarı yalnızca Electron main process tarafından okunur.
# Üretim paketine gömülmez. Değerleri buraya yazmayın; yerel .env kullanın.
# TCMB_EVDS_API_KEY=
# TCMB_EVDS_HIGHEST_DEPOSIT_TRY_SERIES_CODE=TP.TRY.MT04.S
# TCMB_EVDS_HIGHEST_DEPOSIT_TRY_RESPONSE_FIELD=TP_TRY_MT04_S
